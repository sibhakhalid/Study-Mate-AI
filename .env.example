# ── Backend API ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── Firebase client config ──────────────────────────────────────────────
# From Firebase Console → Project Settings → General → Your apps → Web app
# → SDK setup and configuration.
#
# Note: these values are public client identifiers, not secrets — Firebase's
# actual security boundary is enforced server-side (Firestore/Storage rules,
# and this app's own backend verifying ID tokens via firebase-admin). They
# still belong in .env rather than hardcoded in source, so each environment
# (dev/staging/prod) can point at its own Firebase project without a code
# change, and so this file can be gitignored like any other environment
# config.
